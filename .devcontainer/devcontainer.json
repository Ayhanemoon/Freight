{
  "name": "Django Backend",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.languageServer": "Pylance",
        "python.analysis.autoSearchPaths": true,
        "python.analysis.useLibraryCodeForTypes": true
      }
    }
  }
}
